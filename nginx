> Criando os arquivos das APIs no servidor:

# auth
echo '
server {
    listen 80;
    server_name auth.coopertrasmig.coop.br www.auth.coopertrasmig.coop.br;

    location / {
        proxy_pass http://localhost:19001;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
    }
}
' | sudo tee /etc/nginx/sites-available/auth

# gateway
echo '                                                                                                   gateway.conf                                                                                                                
server {
    server_name gateway.coopertrasmig.coop.br www.gateway.coopertrasmig.coop.br;

    location / {
        proxy_pass http://localhost:19005;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_pass_header Authorization;
        proxy_set_header Authorization $http_authorization;
    }


    location /v1/Websocket/rotas {
        proxy_pass http://localhost:19005/v1/Websocket/rotas;

        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;

        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
        proxy_pass_header Authorization;
        proxy_set_header Authorization $http_authorization;
    }

    listen 443 ssl; # managed by Certbot
    ssl_certificate /etc/letsencrypt/live/gateway.coopertrasmig.coop.br/fullchain.pem; # managed by Certbot
    ssl_certificate_key /etc/letsencrypt/live/gateway.coopertrasmig.coop.br/privkey.pem; # managed by Certbot
    include /etc/letsencrypt/options-ssl-nginx.conf; # managed by Certbot
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem; # managed by Certbot


}
server {
    if ($host = www.gateway.coopertrasmig.coop.br) {
        return 301 https://$host$request_uri;
    } # managed by Certbot


    if ($host = gateway.coopertrasmig.coop.br) {
        return 301 https://$host$request_uri;
    } # managed by Certbot


    listen 80;
    server_name gateway.coopertrasmig.coop.br www.gateway.coopertrasmig.coop.br;
    return 404; # managed by Certbot
}
' | sudo tee /etc/nginx/sites-available/gateway

